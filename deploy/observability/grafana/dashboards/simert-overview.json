{
  "title": "SIMERT - Observabilidad",
  "uid": "simert-overview",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Solicitudes por segundo", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }, "targets": [{ "expr": "sum by (service) (rate(simert_http_requests_total[5m]))", "legendFormat": "{{service}}" }] },
    { "id": 2, "type": "timeseries", "title": "Errores HTTP", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }, "targets": [{ "expr": "sum by (service,status) (rate(simert_http_requests_total{status=~\"4..|5..\"}[5m]))", "legendFormat": "{{service}} {{status}}" }] },
    { "id": 3, "type": "timeseries", "title": "Memoria RSS", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }, "targets": [{ "expr": "simert_process_memory_bytes", "legendFormat": "{{service}}" }] },
    { "id": 4, "type": "stat", "title": "Servicios disponibles", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }, "targets": [{ "expr": "count(up{job=\"simert-services\"} == 1)" }] }
  ]
}
