# Plantilla de las variables de la orquestacion.
#
#   cp .env.example .env     y ajusta los valores de esta maquina
#
# El .env real NO se versiona a proposito: WEB_ENV_FILE y TAG difieren entre
# la maquina de desarrollo y el servidor, y un fichero versionado daria
# conflicto en cada git pull.
#
# Estas NO son las variables de la aplicacion: esas siguen viniendo del .env
# de cada servicio, que este stack no toca.

# Puertos publicados. Son los mismos que usa PM2 hoy, a proposito: el nginx del
# host y el firewall siguen apuntando a donde siempre y no hay que tocarlos.
AUTH_PORT=3000
PAY_PORT=3001
SIMERT_PORT=3002
SOCKET_PORT=3003
WEB_PORT=8080

# Interfaz donde se publican los puertos.
#
# 127.0.0.1 a proposito: Docker publica por defecto en 0.0.0.0 y sus reglas de
# iptables SE SALTAN el firewall del host (ufw/firewalld), asi que un
# "ports: 3000:3000" dejaria los servicios expuestos a internet. Con 127.0.0.1
# se conserva la topologia actual: el unico que entra desde fuera es el nginx
# del host.
BIND_ADDR=127.0.0.1

# Zona horaria de los contenedores. Sin esto corren en UTC y los jobs de
# conciliacion y las fechas de las multas se desplazan 5 horas.
TZ=America/Guayaquil

# Runtime de Node para construir las imagenes. Por defecto la misma version
# mayor que se usa en desarrollo (v24). Ajustar si el servidor usa otra.
NODE_VERSION=24-alpine

# Limite de memoria por contenedor y heap de Node.
# Equivale al `max_memory_restart: '600M'` de PM2, con margen.
NEST_MEM_LIMIT=1g
NEST_HEAP_MB=768

# Fichero de entorno con el que se hornea el front (Vue CLI mete las VUE_APP_*
# en el bundle en tiempo de build).
#   desarrollo -> .env          servidor -> .env.production
WEB_ENV_FILE=.env.production

# Etiqueta de las imagenes construidas.
#   desarrollo -> local         servidor -> prod (o la fecha del despliegue)
TAG=prod
